---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import HeaderEn from '../components/HeaderEn.astro';
import Footer from '../components/Footer.astro';
import { SITE_LAST_UPDATED_ZH, SITE_LAST_UPDATED_EN } from '../consts';
import {
	ESTATE_TRUSTEE_PAGES,
	getEstateTrusteePage,
	estateTrusteePath,
	estateTrusteeHubPath,
	type EstateTrusteeSlug,
} from '../data/estate-trustee';

interface Props {
	lang: 'zh' | 'en';
	slug: EstateTrusteeSlug;
	faqs: { q: string; a: string }[];
}

const { lang, slug, faqs } = Astro.props;
const page = getEstateTrusteePage(slug);
const copy = page[lang];
const path = estateTrusteePath(slug, lang);
const pairHref = estateTrusteePath(slug, lang === 'zh' ? 'en' : 'zh');
const hubHref = estateTrusteeHubPath(lang);
const others = ESTATE_TRUSTEE_PAGES.filter((item) => item.slug !== slug);
const origin = 'https://www.miaohelaw.ca';
const pageUrl = `${origin}${path}`;
const zhUrl = `${origin}${estateTrusteePath(slug, 'zh')}`;
const enUrl = `${origin}${estateTrusteePath(slug, 'en')}`;
const lastUpdated = lang === 'zh' ? SITE_LAST_UPDATED_ZH : SITE_LAST_UPDATED_EN;

const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'LegalService',
		name: lang === 'zh' ? `何淼律师 — ${copy.serviceType}` : `Miao He — ${copy.serviceType}`,
		url: pageUrl,
		telephone: '+1-647-930-6688',
		email: 'miao@miaohelaw.ca',
		address: {
			'@type': 'PostalAddress',
			streetAddress: '208-7050 Woodbine Ave',
			addressLocality: 'Markham',
			addressRegion: 'ON',
			addressCountry: 'CA',
		},
		serviceType: [copy.serviceType, lang === 'zh' ? '安省遗产认证' : 'Ontario probate'],
		availableLanguage: [
			{ '@type': 'Language', name: 'Chinese (Mandarin)' },
			{ '@type': 'Language', name: 'English' },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: lang === 'zh' ? '首页' : 'Home',
				item: lang === 'zh' ? `${origin}/` : `${origin}/en/`,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: lang === 'zh' ? '安省遗产认证' : 'Ontario Probate',
				item: `${origin}${hubHref}`,
			},
			{ '@type': 'ListItem', position: 3, name: copy.navLabel, item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
];
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh' : 'en'}>
<head>
  <BaseHead title={copy.title} description={copy.description} />
  <meta name="keywords" content={copy.keywords} />
  <meta property="og:title" content={copy.title} />
  <meta property="og:description" content={copy.description} />
  <link rel="alternate" hreflang="zh" href={zhUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={zhUrl} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  {lang === 'zh' ? <Header /> : <HeaderEn />}
  <main>
    <section class="page-hero">
      <div class="container">
        <div class="breadcrumb">
          {lang === 'zh' ? (
            <>
              <a href="/">首页</a> › <a href={hubHref}>安省遗产认证</a> › {copy.navLabel}
              <span class="lang-pair"> · <a href={pairHref} lang="en">English</a></span>
            </>
          ) : (
            <>
              <a href="/en/">Home</a> › <a href={hubHref}>Ontario Probate</a> › {copy.navLabel}
              <span class="lang-pair"> · <a href={pairHref} lang="zh">中文</a></span>
            </>
          )}
        </div>
        <h1>{copy.h1}</h1>
        <p class="hero-sub">{copy.heroSub}</p>
        <p class="page-last-updated page-last-updated--gradient">
          {lang === 'zh' ? `页面内容最后更新：${lastUpdated}` : `Page last updated: ${lastUpdated}`}
        </p>
      </div>
    </section>

    <section class="content-section">
      <div class="container content-grid">
        <div class="main-content">
          <slot />

          {lang === 'zh' ? (
            <>
              <h2>为什么这类案子要找中加双执照律师</h2>
              <ul class="content-list">
                <li><strong>法院申请，不是填一张表那么简单。</strong>证书由安省 Superior Court of Justice 签发。材料不齐、顺位不对、保证金没处理，法院会退件或改由法官决定，周期立刻拉长。</li>
                <li><strong>继承人在中国是常态，不是例外。</strong>何淼律师处理非居民申请人、保证金减免，以及国内亲属关系、继承权证明要走的公证和<a href="/hague-apostille/">海牙认证</a>。</li>
                <li><strong>符合条件时，用同意申请免除保证金，而不是一上来就动议。</strong>Rule 74.11(5) 允许在全体有权分配的人同意、且没有未成年或无行为能力受益人时，随申请一并请求免除或减免 bond。</li>
                <li><strong>程序不同，费用也不同。</strong>遗产管理税按遗产价值计算；律师费视路径、是否跨境、是否申请免除保证金而定。请来电说明情况，647-930-6688。</li>
              </ul>
            </>
          ) : (
            <>
              <h2>Why dual-licensed counsel matters on these files</h2>
              <ul class="content-list">
                <li><strong>This is a court application, not a form-filling exercise.</strong> The certificate is issued by the Ontario Superior Court of Justice. Missing materials, the wrong applicant, or an unresolved bond will draw a requisition or a judge’s review.</li>
                <li><strong>Heirs in China are the usual fact pattern, not a side issue.</strong> Miao He deals with non-resident applicants, bond relief, and the China-side kinship or inheritance documents that often need notarization and an <a href="/en/hague-apostille/">Apostille</a>.</li>
                <li><strong>Where the rules allow it, dispense with the bond on consent — do not start with a motion.</strong> Rule 74.11(5) lets the request go in with the application when every person entitled to share consents and none is a minor or incapable.</li>
                <li><strong>Fees follow the procedure.</strong> Estate administration tax is calculated on estate value. Legal fees depend on the path, whether the file is cross-border, and whether bond relief is required. Call 647-930-6688 with the facts.</li>
              </ul>
            </>
          )}

          <h2>{lang === 'zh' ? '常见问题' : 'Frequently asked questions'}</h2>
          {faqs.map((item) => (
            <div class="faq-item">
              <h3>{lang === 'zh' ? 'Q：' : 'Q: '}{item.q}</h3>
              <p>{lang === 'zh' ? 'A：' : 'A: '}{item.a}</p>
            </div>
          ))}

          <h2>{lang === 'zh' ? '其他遗产认证说明' : 'Other probate guides'}</h2>
          <div class="doc-grid doc-grid--compact">
            {others.map((item) => (
              <a class="doc-card" href={estateTrusteePath(item.slug, lang)}>
                <h3>{item[lang].cardTitle}</h3>
                <p>{item[lang].cardDesc}</p>
              </a>
            ))}
          </div>

          <div class="cta-box">
            {lang === 'zh' ? (
              <>
                <h3>先打电话说清情况</h3>
                <p>普通话 · 万锦办公室 · 程序不同费用也不同 · 电话或 Zoom</p>
                <a href="/contact/" class="btn-primary">立即预约</a>
                <a href="tel:6479306688" class="btn-secondary">647-930-6688</a>
              </>
            ) : (
              <>
                <h3>Call with the facts of the estate</h3>
                <p>Mandarin &amp; English · Markham · Fees depend on the procedure · Phone or Zoom</p>
                <a href="/en/contact/" class="btn-primary">Book now</a>
                <a href="tel:6479306688" class="btn-secondary">647-930-6688</a>
              </>
            )}
          </div>
        </div>

        <aside class="sidebar">
          <div class="sidebar-card">
            <h3>{lang === 'zh' ? '联系何淼律师' : 'Contact Miao He'}</h3>
            <p>📞 <a href="tel:6479306688">647-930-6688</a></p>
            <p>📧 <a href="mailto:miao@miaohelaw.ca">miao@miaohelaw.ca</a></p>
            <p>📍 208-7050 Woodbine Ave, Markham</p>
            <p>💬 {lang === 'zh' ? '微信：372656035' : 'WeChat: 372656035'}</p>
          </div>
          <div class="sidebar-card">
            <h3>{lang === 'zh' ? '按情况办理' : 'By situation'}</h3>
            <ul>
              <li><a href={hubHref}>{lang === 'zh' ? '遗产认证总览' : 'Probate overview'}</a></li>
              {ESTATE_TRUSTEE_PAGES.map((item) => (
                <li>
                  {item.slug === slug ? (
                    <span>{item[lang].navLabel}</span>
                  ) : (
                    <a href={estateTrusteePath(item.slug, lang)}>{item[lang].navLabel}</a>
                  )}
                </li>
              ))}
              <li><a href={lang === 'zh' ? '/hague-apostille/' : '/en/hague-apostille/'}>{lang === 'zh' ? '海牙认证' : 'Hague Apostille'}</a></li>
            </ul>
          </div>
          <div class="sidebar-card">
            <h3>{lang === 'zh' ? '英文版' : '中文版'}</h3>
            {lang === 'zh' ? (
              <p><a href={pairHref} lang="en">🇨🇦 View in English</a></p>
            ) : (
              <p><a href={pairHref} lang="zh">🇨🇳 中文版</a></p>
            )}
          </div>
        </aside>
      </div>
    </section>
  </main>
  <Footer lang={lang === 'en' ? 'en' : undefined} />
</body>
</html>
<style is:global>
  .page-hero{background:var(--hero-legal-top-background);border-bottom:1px solid rgba(0,0,0,0.35);color:white;padding:3rem 0 2rem}
  .page-hero h1{font-size:2rem;margin:0.5rem 0;color:#ffffff}
  .hero-sub{color:#D4A853;margin:0}
  .breadcrumb{font-size:0.85rem;opacity:0.7;margin-bottom:0.5rem}
  .breadcrumb a{color:white;text-decoration:none}
  .lang-pair{opacity:0.9}
  .container{max-width:1100px;margin:0 auto;padding:0 1.5rem}
  .content-section{padding:3rem 0}
  .content-grid{display:grid;grid-template-columns:1fr 300px;gap:3rem}
  .definition-box{background:#FDF6EC;border-left:4px solid #9A8060;padding:1.2rem 1.5rem;margin-bottom:1.5rem;border-radius:0 8px 8px 0}
  .process-box{display:flex;flex-direction:column;gap:1rem;margin:1.5rem 0}
  .process-step{display:flex;gap:1rem;align-items:flex-start;background:#f8f8f8;border-radius:8px;padding:1rem 1.2rem}
  .step-num{background:#9A8060;color:white;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.9rem;flex-shrink:0;margin-top:2px}
  .process-step strong{color:var(--text-heading);display:block;margin-bottom:0.3rem}
  .process-step p{margin:0;font-size:0.9rem;color:#4A2C1A}
  .content-list{padding-left:1.2rem}
  .content-list li{margin:0.6rem 0;color:#4A2C1A}
  .fine-print{font-size:0.85rem;color:#6b5344;margin-top:0.5rem}
  .faq-item{background:#f8f8f8;border-radius:8px;padding:1.2rem 1.5rem;margin:1.5rem 0;border-left:3px solid #9A8060}
  .faq-item h3{color:var(--text-heading);margin-top:0;font-size:1rem}
  .cta-box{background:linear-gradient(135deg,#2C1810,#4A2C1A);color:white;padding:2rem;border-radius:12px;text-align:center;margin-top:2rem}
  .cta-box h3{margin-top:0;color:#D4A853}
  .cta-box p{color:#ffffff}
  .btn-primary{display:inline-block;background:#D4A853;color:var(--text-heading);padding:0.75rem 1.5rem;border-radius:6px;text-decoration:none;font-weight:700;margin:0.5rem}
  .btn-secondary{display:inline-block;background:transparent;color:white;border:2px solid white;padding:0.75rem 1.5rem;border-radius:6px;text-decoration:none;font-weight:700;margin:0.5rem}
  .doc-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:1.5rem 0}
  .doc-card{display:block;background:#f8f8f8;border-radius:8px;padding:1.1rem 1.2rem;border-left:3px solid #9A8060;text-decoration:none;color:inherit}
  .doc-card h3{color:var(--text-heading);margin:0 0 0.4rem;font-size:0.95rem}
  .doc-card p{margin:0;font-size:0.88rem;color:#4A2C1A}
  .eat-table{width:100%;border-collapse:collapse;margin:1.2rem 0;font-size:0.92rem}
  .eat-table th,.eat-table td{border:1px solid #e8e0d5;padding:0.55rem 0.7rem;text-align:left}
  .eat-table th{background:#FDF6EC;color:var(--text-heading)}
  .sidebar{display:flex;flex-direction:column;gap:1.5rem}
  .sidebar-card{background:white;border:1px solid #e8e0d5;border-radius:10px;padding:1.2rem}
  .sidebar-card h3{color:var(--text-heading);font-size:0.95rem;margin-top:0;border-bottom:1px solid #e8e0d5;padding-bottom:0.5rem;margin-bottom:0.75rem}
  .sidebar-card ul{list-style:none;padding:0;margin:0}
  .sidebar-card li{padding:0.3rem 0;border-bottom:1px solid #f0ebe3;font-size:0.9rem}
  .sidebar-card a{color:#9A8060;text-decoration:none}
  .sidebar-card p{margin:0.3rem 0;font-size:0.9rem}
  h2{color:var(--text-heading);margin-top:2rem}
  h3{color:#4A2C1A}
  @media(max-width:768px){.content-grid{grid-template-columns:1fr}.page-hero h1{font-size:1.5rem}.doc-grid{grid-template-columns:1fr}}
</style>
