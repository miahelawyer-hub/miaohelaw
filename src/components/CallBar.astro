  <button class="call-row call-wechat" id="wechat-btn" aria-label="微信扫码咨询">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M2 8.5C2 5.46 4.91 3 8.5 3S15 5.46 15 8.5c0 .17-.01.34-.03.5H15c3.31 0 6 2.24 6 5s-2.69 5-6 5c-.87 0-1.69-.17-2.44-.47L10 19.5l.5-2C9.4 17.83 8.23 18 7 18c-3.31 0-6-2.24-6-5 0-2.07 1.33-3.87 3.28-4.75A6.5 6.5 0 0 1 2 8.5z"/>
