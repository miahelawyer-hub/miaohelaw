---
import CallBar from './CallBar.astro';
const today = new Date();
const { lang = 'zh' } = Astro.props;
---

<CallBar />
<footer>
	<div class="footer-inner">
		<div class="footer-grid">
			<section class="footer-col" aria-label={lang === 'en' ? 'Contact' : '联系'}>
				<div class="footer-h">{lang === 'en' ? 'Contact' : '联系'}</div>
				<div class="chip-stack">
					<a class="chip chip-wide" href="tel:6479306688"><span class="ico">📞</span><span>647-930-6688</span></a>
					<a class="chip chip-wide" href="mailto:miao@miaohelaw.ca"><span class="ico">✉️</span><span>miao@miaohelaw.ca</span></a>
					<div class="chip chip-wide"><span class="ico">📍</span><span>208-7050 Woodbine Ave, Markham, ON L3R 4G8</span></div>
				</div>
			</section>

			<section class="footer-col" aria-label={lang === 'en' ? 'Credentials' : '资质'}>
				<div class="footer-h">{lang === 'en' ? 'Credentials' : '资质'}</div>
				<div class="chip-stack">
					<a class="chip chip-wide" href="https://lso.ca/home" target="_blank" rel="noopener"><span class="ico">⚖️</span><span>LSO #83315K</span></a>
					<a class="chip chip-wide" href="https://www.hlawfirmontario.com" target="_blank" rel="noopener"><span class="ico">🏢</span><span>H. LAW FIRM</span></a>
					<div class="chip chip-wide"><span class="ico">🇨🇳</span><span>{lang === 'en' ? 'China Bar · Dual-licensed' : '中国律师协会 · 双执照'}</span></div>
				</div>
			</section>

			<section class="footer-col footer-col-connect" aria-label={lang === 'en' ? 'Follow and WeChat' : '关注与微信'}>
				<div class="footer-connect-head">
					<div class="footer-h">{lang === 'en' ? 'Follow & WeChat' : '关注与微信'}</div>
					<div class="social-links social-links-head" aria-label="Social links">
						<a href="https://www.linkedin.com/in/mia-he-93422b160/" target="_blank" rel="noopener" aria-label="LinkedIn">
							<span class="sr-only">LinkedIn</span>
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
						</a>
						<a href="https://youtube.com/channel/UCLtXNA90GpKWbt6k-nOgL7w" target="_blank" rel="noopener" aria-label="YouTube">
							<span class="sr-only">YouTube</span>
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
								<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
							</svg>
						</a>
						<a href="https://www.tiktok.com/@mamashidawang" target="_blank" rel="noopener" aria-label="TikTok">
							<span class="sr-only">TikTok</span>
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
								<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.75a4.85 4.85 0 0 1-1.01-.06z"/>
							</svg>
						</a>
					</div>
				</div>
				<div class="chip-stack">
					<div class="wechat-card" aria-label="WeChat">
						<button
							type="button"
							class="wechat-qr-trigger"
							id="footer-wechat-qr-open"
							aria-haspopup="dialog"
							aria-controls="footer-wechat-qr-dialog"
							aria-label={lang === 'en' ? 'Enlarge WeChat QR code' : '放大查看微信二维码'}
						>
							<img src="/wechat-qr.jpg" alt="" class="wechat-qr" width="44" height="44" decoding="async" />
						</button>
						<div class="wechat-meta">
							<div class="wechat-title">{lang === 'en' ? 'Scan to chat' : '扫码咨询'}</div>
							<div class="wechat-id">{lang === 'en' ? 'ID: 372656035' : '微信号：372656035'}</div>
						</div>
					</div>
					<div class="chip chip-wide footer-legal" aria-label="Legal links">
						{lang === 'en' ? (
							<>
								<a href="/en/privacy-policy">Privacy</a>
								<span class="dot">·</span>
								<a href="/en/terms-of-use">Terms</a>
							</>
						) : (
							<>
								<a href="/privacy-policy">隐私</a>
								<span class="dot">·</span>
								<a href="/terms-of-use">条款</a>
							</>
						)}
					</div>
				</div>
			</section>
		</div>

		<div class="footer-copy">
			&copy; {today.getFullYear()} Miao He (何淼). All rights reserved.
		</div>
	</div>
</footer>

<dialog class="wechat-qr-dialog" id="footer-wechat-qr-dialog" aria-labelledby="footer-wechat-qr-dialog-title">
	<div class="wechat-qr-dialog-panel">
		<button type="button" class="wechat-qr-dialog-close" data-wechat-qr-close aria-label={lang === 'en' ? 'Close' : '关闭'}>
			<span aria-hidden="true">×</span>
		</button>
		<p class="wechat-qr-dialog-title" id="footer-wechat-qr-dialog-title">
			{lang === 'en' ? 'WeChat QR' : '微信二维码'}
		</p>
		<img src="/wechat-qr.jpg" alt={lang === 'en' ? 'WeChat QR code — scan to add' : '何淼律师微信二维码，扫码添加'} class="wechat-qr-dialog-img" width="520" height="520" decoding="async" />
		<p class="wechat-qr-dialog-hint">{lang === 'en' ? 'Click outside or press Esc to close.' : '点击空白处或按 Esc 关闭。'}</p>
	</div>
</dialog>

<script src="/js/footer-wechat-dialog.js" defer></script>