---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { DOCUMENT_EMAIL } from '../../data/intake-forms';
import '../../styles/intake.css';

const title = '表格已提交 | H. LAW FIRM';
const description = '客户登记表已提交。本页不公开收录。';
---

<!doctype html>
<html lang="zh">
	<head>
		<BaseHead title={title} description={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="googlebot" content="noindex, nofollow" />
	</head>
	<body>
		<Header />
		<main>
			<article class="intake">
				<div class="intake-success">
					<h1>已收到</h1>
					<p>表格已经提交。律师会查看您填写的资料。</p>
					<p>
						两份有效身份证件请另发至
						<a href={`mailto:${DOCUMENT_EMAIL}`}>{DOCUMENT_EMAIL}</a>
						（护照；PR卡正反面；加拿大驾照正反面）。
					</p>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
