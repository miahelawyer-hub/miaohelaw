import HagueDoc from '../../../layouts/HagueDoc.astro';

const faqs = [
  {
    q: 'Does a Canadian divorce certificate need an Apostille for use in China?',
    a: 'Remarriage, civil affairs, banking or property filings in China almost always require one. A court seal or a lawyer’s certified copy is often not enough. Call 647-930-6688.',
  },
  {
    q: 'I only have the divorce order, not the certificate. Can that be apostilled?',
    a: 'Yes. A court divorce order can be apostilled. For remarriage registration in China, the Certificate of Divorce is the document they more often ask for. Miao He is a litigation lawyer and will confirm which instrument you have and which one the receiving office wants.',
  },
  {
    q: 'Is notarization required for a court-issued divorce certificate?',
    a: 'An Ontario court public document is usually sent straight to Official Documents Services for an Apostille. It is not treated like a private POA that must be notarized first. Miao He checks ODS requirements for that court document and files it.',
  },
  {
    q: 'Can I pick up the original the next day?',
    a: 'If the court has already issued the certificate and the file is complete, urgent Apostille originals can be collected the next day. A recent Canadian divorce-certificate Apostille went through on the first pass. If you still have to apply to the court for the certificate, that issuance takes its own time. 647-930-6688.',
  },
];
---
<HagueDoc lang="en" slug="canada-divorce-certificate" faqs={faqs}>
  <div class="definition-box">
    <p>Miao He recently apostilled a <strong>Canadian divorce certificate</strong> for use in China. She is familiar with court-document procedure — dual-licensed China–Canada litigation lawyer — and urgent clients can collect the original the next day. The file went through on the first pass.</p>
  </div>

  <h2>When you need it</h2>
  <p>The Ontario divorce is done. The paper has to be used in China. Typical uses:</p>
  <ul class="content-list">
    <li>remarriage registration in China;</li>
    <li>civil affairs, hukou or identity-document changes;</li>
    <li>a bank or property transfer that requires proof of marital status;</li>
    <li>a China lawsuit or notary office that asks for foreign divorce proof.</li>
  </ul>
  <p>Clients often mix up two documents: the <strong>divorce order</strong> and the <strong>Certificate of Divorce</strong>. Civil-affairs offices in China usually want the certificate. Miao He is a litigation lawyer. She knows how Ontario courts issue each document, and which one the window in China is actually asking for.</p>

  <h2>What an Apostille does — and does not do</h2>
  <p>A Canadian divorce order is not automatically enforceable in China. There is no civil-judgment recognition treaty. An apostilled certificate or order can still be used as proof for remarriage, notarization or litigation in China. The Apostille proves the Canadian document is genuine. It does not make a Chinese court enforce a Canadian property order.</p>
  <p>If you also need to sell or register property in China, you may need a <a href="/en/hague-apostille/china-property-power-of-attorney/">Power of Attorney</a> at the same time. Plan both files before anything is couriered.</p>

  <h2>What to bring</h2>
  <ul class="content-list">
    <li>the Certificate of Divorce original, or the Ontario court divorce order;</li>
    <li>passport and ID matching the name on the court document;</li>
    <li>the civil-affairs bureau or notary office’s list, if they issued one.</li>
  </ul>
</HagueDoc>
